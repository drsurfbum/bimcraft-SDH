  {
    "name": "walls_edit",
    "title": "walls_edit",
    "description": "Change only walls identified by GlobalId, including authored type assignment, six location lines, exterior side and existing height/top settings. No join/end or reference-dimension editing. One atomic Assistant undo step. Values are mm. Requires the inspected documentId and revision. (Permission: edit.)",
    "inputSchema": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "walls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "changes": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Dynamic key from assemblies_list or model_describe; no built-in fallback."
            },
            "locationLine": {
              "type": "string",
              "enum": [
                "center",
                "exterior",
                "interior",
                "coreCenter",
                "coreExterior",
                "coreInterior"
              ]
            },
            "exteriorSide": {
              "type": "string",
              "enum": [
                "left",
                "right"
              ]
            },
            "height": {
              "type": "number",
              "minimum": 100,
              "maximum": 100000
            },
            "topLevel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "Exact storey GlobalId. Mutually exclusive with height."
            },
            "baseOffset": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "topOffset": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "documentId",
        "expectedRevision",
        "walls",
        "changes"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "walls_edit",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
