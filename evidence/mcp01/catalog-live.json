        },
        "points": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -10000000,
              "maximum": 10000000
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 2,
          "maxItems": 500
        },
        "closed": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Dynamic key from assemblies_list or model_describe; no built-in fallback."
        },
        "locationLine": {
          "type": "string",
          "enum": [
            "center",
            "exterior",
            "interior",
            "coreCenter",
            "coreExterior",
            "coreInterior"
          ]
        },
        "exteriorSide": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        },
        "height": {
          "type": "number",
          "minimum": 100,
          "maximum": 100000
        },
        "topLevel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Exact storey GlobalId. Mutually exclusive with height."
        },
        "baseOffset": {
