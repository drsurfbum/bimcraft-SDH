        },
        "changes": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "category": {
              "type": "string",
              "maxLength": 100
            },
            "defaultThickness": {
              "type": "number",
              "minimum": 0,
              "maximum": 2000,
              "description": "mm. A library default; never resizes existing recipe layers."
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "fill": {
              "type": "string",
              "enum": [
                "none",
                "solid",
                "diagonal",
                "crosshatch"
              ]
            },
            "fillColor": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "notes": {
              "type": "string",
