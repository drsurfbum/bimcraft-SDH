  {
    "name": "assembly_create",
    "title": "assembly_create",
    "description": "Create an unused authored assembly. Layers have explicit material IDs and mm widths. One atomic Assistant undo step. Values are mm. Requires the inspected documentId and revision. (Permission: edit.)",
    "inputSchema": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "key": {
          "type": "string",
          "pattern": "^wall-[a-zA-Z0-9_-]{1,80}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "exterior": {
          "type": "boolean"
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mat": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "t": {
                "type": "number",
                "minimum": 0,
                "maximum": 2000,
                "description": "Explicit mm; zero only for material membranes."
              },
              "function": {
                "type": "string",
                "enum": [
                  "finish",
                  "substrate",
                  "structure",
                  "insulation",
                  "membrane"
                ]
              },
              "core": {
                "type": "boolean"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "material",
                  "cavity"
                ]
              },
              "materialId": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 809
              },
              "ventilation": {
                "type": "string",
                "enum": [
                  "unspecified",
                  "unventilated",
                  "ventilated"
                ]
              }
            },
            "required": [
              "mat",
              "t",
              "function",
              "core",
              "kind",
              "materialId"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 32,
          "description": "Ordered exterior to interior. One contiguous physical core."
        }
      },
      "required": [
        "documentId",
        "expectedRevision",
        "key",
        "name",
        "exterior",
        "layers"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "assembly_create",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
