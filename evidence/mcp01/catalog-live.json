  {
    "name": "material_create",
    "title": "material_create",
    "description": "Create a project material; retain unused definitions. One atomic Assistant undo step. Values are mm. Requires the inspected documentId and revision. (Permission: edit.)",
    "inputSchema": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "id": {
          "type": "string",
          "pattern": "^material-[a-zA-Z0-9_-]{1,800}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "maxLength": 100
        },
        "defaultThickness": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000,
          "description": "mm. A library default; never resizes existing recipe layers."
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "fill": {
          "type": "string",
          "enum": [
            "none",
            "solid",
            "diagonal",
            "crosshatch"
          ]
        },
        "fillColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "documentId",
        "expectedRevision",
        "id",
        "name",
        "defaultThickness",
        "color",
        "fill",
        "fillColor"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "material_create",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "material_edit",
    "title": "material_edit",
    "description": "Edit an explicitly identified project material; defaults do not change instance layer widths. One atomic Assistant undo step. Values are mm. Requires the inspected documentId and revision. (Permission: edit.)",
