[
  {
    "name": "elements_find",
    "title": "Find elements",
    "description": "Find elements of the open IFC model by class, storey, name or property value. Returns their ids for elements_isolate and element_properties. (Permission: read.)",
    "inputSchema": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "description": "IFC class, e.g. IfcWall (case does not matter)."
        },
        "storey": {
          "type": "string",
          "description": "Storey name, exactly as the model names it."
        },
        "name": {
          "type": "string",
          "description": "Text the element name contains."
        },
        "property": {
          "type": "object",
          "description": "A property (or quantity) value. Without \"set\", any set holding a property of that name.",
          "properties": {
            "set": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "equals": {
              "type": "string"
            },
            "contains": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "rules": {
          "type": "array",
          "maxItems": 20,
          "description": "BimCraft Find rules; field = cls, type, storey, material, name, longname, objtype, tag, predefined, guid or p:<Set>.<Property>.",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "op": {
                "type": "string",
                "enum": [
                  "is",
                  "isnot",
                  "contains",
                  "notcontains",
                  "starts",
                  "gt",
                  "lt",
                  "gte",
                  "lte",
                  "has",
                  "hasnot"
                ]
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "field",
              "op"
            ],
            "additionalProperties": false
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "all",
            "any"
          ],
          "description": "all = every rule must match (default), any = one is enough."
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "title": "Find elements",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
